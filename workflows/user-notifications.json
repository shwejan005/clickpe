        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { From: { Email: $json.from }, To: [{ Email: $json.to }], Subject: $json.subject, Text: $json.text } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "04ecfe05-c073-4bd2-89d8-4db25fd2dd97",
      "name": "Send through local Mailpit API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "isBodyHtml": false,
        "subject": "={{ $json.subject }}",
        "body": "={{ $json.text }}",
        "fromEmail": "={{ $json.from }}",
        "toAddresses": [
          "={{ $json.to }}"
        ],
        "additionalFields": {}
      },
      "id": "f5cd310d-c615-4be8-b9be-3b4116bf4d1d",
      "name": "Send through AWS SES",
