        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { batch_id: $('One email per applicant').item.json.batch_id, applicant_id: $('One email per applicant').item.json.applicant_id, claim_id: $('One email per applicant').item.json.claim_id, delivered: true, channel: ($env.LOAN_NOTIFICATION_TRANSPORT === 'ses' ? 'ses' : 'mailpit'), is_last: $('One email per applicant').item.json.is_last, continue_after_page: $('One email per applicant').item.json.continue_after_page } }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
