      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const page = $input.first().json;\nconst messages = page.messages || [];\nreturn messages.map((message, index) => ({ json: { ...message, is_last: index === messages.length - 1, continue_after_page: page.continue_after_page === true } }));"
      },
      "id": "4acbdc94-46cd-4ef0-b796-2b6eac31e70f",
      "name": "One email per applicant",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $env.LOAN_NOTIFICATION_TRANSPORT === 'ses' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "37c7ef20-f3a9-4bf9-96c6-8586940772a0",
      "name": "Choose SES or local Mailpit",
