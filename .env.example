# Copy to .env before starting the local stack. These values are for local development only.
POSTGRES_DB=loan_engine
POSTGRES_USER=loan_engine
POSTGRES_PASSWORD=replace-with-a-local-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-key

# Optional notification routing. Keep blank to disable sending from the application.
# n8n SMTP should point to mailpit:1025; Mailpit captures mail locally.
NOTIFICATION_TEST_RECIPIENT=demo@localhost
MAIL_FROM=loan-engine@localhost

# Optional Gemini key. Used only to propose lender-rule extraction when deterministic discovery is incomplete.
# Proposals stay out of matching until reviewed and approved through the API.
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest

# Firebase Web app configuration (public client identifiers; use separate projects per environment).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK credentials stay server-side. Put the downloaded service-account JSON
# in ./secrets/firebase-service-account.json; never commit it.
FIREBASE_PROJECT_ID= # Same project ID as VITE_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# Verified Firebase account that can bootstrap the first workspace/platform administrator.
FIREBASE_BOOTSTRAP_ADMIN_EMAIL=
DEFAULT_WORKSPACE_NAME=ClickPe Local Workspace
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# Service-to-service authorization for n8n callbacks. Generate a random value locally; never commit it.
N8N_SERVICE_TOKEN=

# Notification transport is mailpit locally. Set to ses on an AWS n8n host and
# assign an AWS credential to the AWS SES node in the imported workflow.
LOAN_NOTIFICATION_TRANSPORT=mailpit
N8N_AWS_SYSTEM_CREDENTIALS_ACCESS_ENABLED=false

# Optional direct-to-S3 upload mode. Leave VITE_UPLOAD_MODE=local for Docker Compose.
VITE_UPLOAD_MODE=local
VITE_UPLOAD_PRESIGN_URL=

# AWS deployment inputs (fill these yourself; do not commit real values).
AWS_REGION=ap-south-1
APP_ORIGIN=
APP_DOMAIN=
API_DOMAIN=
N8N_DOMAIN=
UPLOAD_API_DOMAIN=
UPLOAD_API_CERTIFICATE_ARN=
FIREBASE_SERVICE_ACCOUNT_SECRET_ARN=
DB_HOST=
DB_PORT=5432
DB_NAME=loan_engine
DB_MASTER_USERNAME=loan_engine
DB_PASSWORD=
N8N_MATCH_WEBHOOK=
N8N_SERVICE_TOKEN_SECRET_ARN=
SES_FROM_EMAIL=


